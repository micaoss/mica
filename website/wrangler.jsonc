{
  // Static assets with one API route: Cloudflare serves ./dist directly, and a
  // request matching no asset reaches the Worker, which answers /api/catalog.
  "name": "micaos-dev",
  "compatibility_date": "2026-09-15",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist"
  },
  // The parsed catalogue lives in KV; the read path never calls GitHub.
  "kv_namespaces": [
    { "binding": "KV", "id": "c55809c8a72a4d1b9ac52c2484cc9c29" }
  ],
  // No cron: the catalogue is built and written by CI, which can read GitHub
  // reliably. See website/README.md, "Where the rows come from".

  // Both hostnames resolve to this Worker; the zone has to be on the same
  // Cloudflare account.
  "routes": [
    { "pattern": "micaos.dev", "custom_domain": true },
    { "pattern": "www.micaos.dev", "custom_domain": true }
  ]
}
