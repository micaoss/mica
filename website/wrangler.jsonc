{
  // Static assets with one API route: Cloudflare serves ./dist directly, and a
  // request matching no asset reaches the Worker, which answers /api/catalog.
  "name": "micaos-dev",
  "compatibility_date": "2026-09-15",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The pages whose HTML carries board wording, which is the resource
    // service's: the Worker fills it in when the page is requested.
    "run_worker_first": ["/", "/en/", "/download/*", "/en/download/*", "/api/*"]
  },
  // No binding and no cron: the Worker reads the resource service on request and
  // holds the answer in the edge cache. See website/README.md, "Where the rows
  // come from".

  // Both hostnames resolve to this Worker; the zone has to be on the same
  // Cloudflare account.
  "routes": [
    { "pattern": "micaos.dev", "custom_domain": true },
    { "pattern": "www.micaos.dev", "custom_domain": true }
  ]
}
