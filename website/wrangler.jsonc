{
  // Static assets with one API route: Cloudflare serves ./dist directly, and a
  // request matching no asset reaches the Worker, which answers /api/catalog.
  "name": "micaos-dev",
  "compatibility_date": "2026-09-15",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist"
  },
  // The parsed catalogue lives in KV; the read path never calls GitHub. Create
  // the namespace with `wrangler kv namespace create CATALOG`, paste the id, and
  // uncomment both blocks — deploying with a namespace that does not exist fails.
  // "kv_namespaces": [
  //   { "binding": "CATALOG", "id": "..." }
  // ],
  // The cron rebuilds the stored catalogue; a manual refresh is
  // POST /api/catalog/refresh with the REFRESH_TOKEN secret.
  // "triggers": {
  //   "crons": ["*/30 * * * *"]
  // },
  "vars": {
    "CATALOG_REPO": "micaoss/mica-build",
    // Temporary: answers the labelled sample instead of KV. Remove once the
    // namespace exists and a refresh has run.
    "CATALOG_DEMO": "1"
  },
  // Both hostnames resolve to this Worker; the zone has to be on the same
  // Cloudflare account.
  "routes": [
    { "pattern": "micaos.dev", "custom_domain": true },
    { "pattern": "www.micaos.dev", "custom_domain": true }
  ]
}
