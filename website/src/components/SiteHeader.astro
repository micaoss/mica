---
import type { Copy, LocaleCode } from '@/shared/i18n'
import { LanguagePicker } from '@/features/landing/components/language-picker'
import { MobileNav } from '@/features/landing/components/mobile-nav'
import { ThemeSelect } from '@/features/landing/components/theme-select'
import { downloadHref, GITHUB_ORG_URL } from '@/features/landing/links'
import { BrandIcon, BrandWordmark } from '@/shared/components/brand-mark'

interface Props {
  copy: Copy
  locale: LocaleCode
  /** Where each locale serves the current page. */
  paths: Record<LocaleCode, string>
  homeHref: string
  docsHref: string
  /** The docs variant swaps the section links for the repository. */
  variant?: 'landing' | 'docs'
  /** Set inside Starlight's layout, which pads its own header container. */
  flush?: boolean
}

const { copy, locale, paths, homeHref, docsHref, variant = 'landing', flush = false } = Astro.props

const download = downloadHref(locale)

const links
  = variant === 'landing'
    ? [
        { href: download, label: copy.nav.download },
        { href: docsHref, label: copy.nav.docs },
      ]
    : [
        { href: download, label: copy.nav.download },
        { href: GITHUB_ORG_URL, label: 'GitHub' },
      ]

const navLink = 'rounded-lg px-2 py-1.5 text-sm whitespace-nowrap text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground hover:no-underline'

// This site's pages centre on a 1200px measure; Starlight's layout is full
// width and pads its own header, so there the gutter would misalign the logo.
const gutter = flush ? 'px-0' : 'px-nav-gutter'
---

<nav
  class:list={['flex items-center gap-3', flush ? 'h-full' : 'py-4', gutter]}
>
  <a href={homeHref} class="flex shrink-0 items-center gap-2.5 no-underline hover:no-underline">
    <BrandIcon />
    <BrandWordmark />
  </a>

  <span class="min-w-3 flex-1"></span>

  {/* Wide viewports show the links inline. */}
  <div class="hidden items-center gap-1 md:flex">
    {links.map(link => <a href={link.href} class={navLink}>{link.label}</a>)}
  </div>

  <div class="flex items-center gap-0.5">
    <ThemeSelect
      client:load
      label={copy.nav.themeLabel}
      labels={{
        auto: copy.nav.themeAuto,
        light: copy.nav.themeLight,
        dark: copy.nav.themeDark,
      }}
    />
    <LanguagePicker client:load locale={locale} label={copy.nav.langLabel} paths={paths} />
  </div>

  {/* Narrow viewports collect them into a drawer. */}
  <div class="md:hidden">
    <MobileNav client:load label={copy.nav.menu} closeLabel={copy.nav.close} links={links} />
  </div>
</nav>
