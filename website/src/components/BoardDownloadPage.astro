---
import type { LocaleCode } from '@/shared/i18n'
import SiteHeader from '@/components/SiteHeader.astro'
import { DownloadExplorer } from '@/features/download/components/download-explorer'
import { SiteFooter } from '@/features/landing/components/site-footer'
import { docsHref, docsPageHref, downloadHref, homeHref } from '@/features/landing/links'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Card, CardContent } from '@/shared/components/ui/card'
import { copyFor, localePathsFromUrl } from '@/shared/i18n'

interface Props {
  locale: LocaleCode
  board: string
  hardware: string
  status: string
}

const { locale, board, hardware, status } = Astro.props
const copy = copyFor(locale)

const guides = [
  { ...copy.download.boardDocs.install, href: docsPageHref(locale, 'user/install') },
  { ...copy.download.boardDocs.update, href: docsPageHref(locale, 'user/update-rollback') },
  { ...copy.download.boardDocs.trouble, href: docsPageHref(locale, 'user/troubleshooting') },
]
---

<BaseLayout
  copy={copy}
  title={`${board} — ${copy.download.title} — Mica OS`}
  description={copy.download.boardLead}
>
  <SiteHeader
    copy={copy}
    locale={locale}
    paths={localePathsFromUrl(Astro.url.pathname)}
    homeHref={homeHref(locale)}
    docsHref={docsHref(locale)}
  />
  <div class="mx-auto max-w-[1200px] px-gutter">
    <header class="border-b border-border pt-14 pb-10">
      <a class="text-[13px] no-underline" href={downloadHref(locale)}>
        ← {copy.download.backToBoards}
      </a>
      <h1
        class="mt-4 mb-0 font-mono text-[clamp(28px,5vw,44px)] leading-[1.15] font-semibold tracking-tight"
      >
        {board}
      </h1>
      <p class="mt-3 mb-0 text-[15px] leading-7 text-muted-foreground">
        {hardware} · {status}
      </p>
      <p class="mt-3 mb-0 max-w-[72ch] text-[15px] leading-7 text-muted-foreground">
        {copy.download.boardLead}
      </p>
    </header>

    <section class="pt-10 pb-16">
      <DownloadExplorer client:load copy={copy} board={board} />
    </section>

    <section class="border-t border-border py-14">
      <h2 class="m-0 text-[clamp(22px,3vw,28px)] leading-[1.2] font-semibold tracking-tight">
        {copy.download.boardDocs.heading}
      </h2>
      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6">
        {
          guides.map(guide => (
            <a href={guide.href} class="group block text-foreground no-underline hover:no-underline">
              <Card className="h-full gap-0 p-6 transition-colors group-hover:border-ring">
                <CardContent className="p-0">
                  <h3 class="m-0 text-lg leading-6 font-semibold tracking-tight">{guide.title}</h3>
                  <p class="mt-2.5 mb-0 text-[15px] leading-7 text-muted-foreground">{guide.body}</p>
                  <span class="mt-4 inline-block text-[15px] text-brand-strong">{guide.cta}</span>
                </CardContent>
              </Card>
            </a>
          ))
        }
      </div>
    </section>

    <section class="border-t border-border py-14">
      <h2 class="m-0 text-[clamp(22px,3vw,28px)] leading-[1.2] font-semibold tracking-tight">
        {copy.download.verify.heading}
      </h2>
      <p class="mt-4 mb-0 max-w-[72ch] text-[15px] leading-7 text-muted-foreground">
        {copy.download.verify.body}
      </p>
      <pre
        class="mt-6 overflow-x-auto rounded-xl border border-border bg-card px-5 py-4 font-mono text-[13px] leading-6"
      >{copy.download.verify.command}</pre>
      <p class="mt-4 mb-0 max-w-[72ch] text-[15px] leading-7 text-muted-foreground">
        {copy.download.verify.note}
      </p>
    </section>

    <SiteFooter copy={copy} />
  </div>
</BaseLayout>
