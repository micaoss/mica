---
import BoardDownloadPage from '@/components/BoardDownloadPage.astro'
import { CONFIGURED_BOARDS } from '@/features/download/boards'

// A board has a page when `boards.json` configures it; what it is called is
// the resource service's, filled in when the page is requested.
export function getStaticPaths() {
  return CONFIGURED_BOARDS.map(board => ({ params: { board } }))
}

const { board } = Astro.params
---

<BoardDownloadPage locale="zh" board={board!} />
