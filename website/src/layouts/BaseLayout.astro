---
import type { Copy } from '@/shared/i18n'
import FontPreload from '@/components/FontPreload.astro'
import ThemeScript from '@/components/ThemeScript.astro'
import '@/styles/global.css'

interface Props {
  copy: Copy
  title?: string
  description?: string
}

const { copy, title = copy.meta.title, description } = Astro.props
---

<!doctype html>
<html lang={copy.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <FontPreload />
    <ThemeScript />
  </head>
  <body class="relative">
    {/* A wash of the brand colour at the top, scrolling away with the content. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] bg-gradient-to-b from-brand/10 to-transparent"
    >
    </div>
    <slot />
  </body>
</html>
